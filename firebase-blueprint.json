{
  "entities": {
    "allowedEmail": {
      "title": "AllowedEmail",
      "description": "Pre-authorized emails allowed to register into the Major guild system.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "Authorized user email address in lowercase."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "member"],
          "description": "Pre-assigned role in the system."
        },
        "addedBy": {
          "type": "string",
          "maxLength": 120,
          "description": "UID or email of the admin who granted access."
        },
        "note": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional note about the pre-authorized member."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when the email was whitelisted."
        }
      },
      "required": ["email", "role", "addedBy", "createdAt"]
    },
    "userProfile": {
      "title": "UserProfile",
      "description": "Private user profile containing PII (email) and personal preferences, strictly isolated to owner and admins.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "User email address (PII)."
        },
        "charName": {
          "type": "string",
          "maxLength": 60,
          "description": "Tibia character name verified via Guild API."
        },
        "guildName": {
          "type": "string",
          "maxLength": 60,
          "description": "Guild name (e.g., Missclick or Caxambu)."
        },
        "rank": {
          "type": "string",
          "enum": ["Leader", "Challenger", "Guardian", "Loyal", "Member", "Beginner", "Newcomer"],
          "description": "Guild hierarchy priority rank."
        },
        "vocation": {
          "type": "string",
          "maxLength": 50,
          "description": "Tibia character vocation."
        },
        "level": {
          "type": "number",
          "description": "Tibia character level."
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Whether user has full administrative privileges."
        },
        "sharedWith": {
          "type": "array",
          "description": "List of UIDs or 'all' allowed to see this user's reservation details."
        },
        "trackedXpUids": {
          "type": "array",
          "description": "List of UIDs tracked by this user for XP monitoring."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of registration."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last profile update."
        }
      },
      "required": ["uid", "email", "charName", "guildName", "rank", "isAdmin"]
    },
    "memberDirectory": {
      "title": "MemberDirectory",
      "description": "PII-free guild member directory (no emails or admin flags) readable by whitelisted guild members.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID."
        },
        "charName": {
          "type": "string",
          "maxLength": 60,
          "description": "Tibia character name."
        },
        "guildName": {
          "type": "string",
          "maxLength": 60,
          "description": "Guild name."
        },
        "rank": {
          "type": "string",
          "enum": ["Leader", "Challenger", "Guardian", "Loyal", "Member", "Beginner", "Newcomer"],
          "description": "Guild priority rank."
        },
        "vocation": {
          "type": "string",
          "maxLength": 50,
          "description": "Tibia character vocation."
        },
        "level": {
          "type": "number",
          "description": "Tibia character level."
        },
        "sharedWith": {
          "type": "array",
          "description": "List of UIDs or 'all' allowed to view this player's hunts."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp."
        }
      },
      "required": ["uid", "charName", "guildName", "rank"]
    },
    "reservation": {
      "title": "Reservation",
      "description": "Public schedule slot occupancy for whitelisted guild members (zero PII/names).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique reservation key."
        },
        "day": {
          "type": "string",
          "enum": ["friday", "saturday", "sunday"],
          "description": "Weekend day of the respawn."
        },
        "slotType": {
          "type": "string",
          "enum": ["normal", "3h", "planilhados"],
          "description": "Slot category."
        },
        "timeSlot": {
          "type": "string",
          "maxLength": 40,
          "description": "Time window."
        },
        "respawnName": {
          "type": "string",
          "maxLength": 80,
          "description": "Name of the hunt respawn."
        },
        "userUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID of the reserving member."
        },
        "isOccupied": {
          "type": "boolean",
          "description": "True indicating slot is currently taken."
        },
        "isPublicVisibility": {
          "type": "boolean",
          "description": "Whether the owner opted into displaying their charName to guild members."
        },
        "partyMemberUids": {
          "type": "array",
          "description": "UIDs of party members invited to this hunt."
        },
        "releasedRespawnId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional released respawn document ID consumed atomically during claim."
        },
        "reservedAt": {
          "type": "string",
          "description": "ISO timestamp when booked."
        }
      },
      "required": ["id", "day", "slotType", "timeSlot", "respawnName", "userUid"]
    },
    "reservationDetails": {
      "title": "ReservationDetails",
      "description": "Sensitive booking details (character name, party, notes) restricted to owner, shared members, or admins.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Matches reservation ID."
        },
        "charName": {
          "type": "string",
          "maxLength": 60,
          "description": "Tibia character name of reserving player."
        },
        "userUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID."
        },
        "userRank": {
          "type": "string",
          "maxLength": 30,
          "description": "Guild rank."
        },
        "partyMembers": {
          "type": "string",
          "maxLength": 300,
          "description": "Party compositions."
        },
        "partyMemberUids": {
          "type": "array",
          "description": "UIDs of party members."
        },
        "sharedViewerUids": {
          "type": "array",
          "description": "UIDs or 'all' granted visibility by the owner."
        },
        "isPublicVisibility": {
          "type": "boolean",
          "description": "Visibility flag."
        },
        "notes": {
          "type": "string",
          "maxLength": 240,
          "description": "Hunt notes."
        },
        "releasedRespawnId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional released respawn document ID consumed atomically during claim."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp."
        }
      },
      "required": ["id", "charName", "userUid"]
    },
    "guildSetting": {
      "title": "GuildSetting",
      "description": "Global configuration and cached guild data.",
      "type": "object",
      "properties": {
        "activeGuilds": {
          "type": "string",
          "maxLength": 200,
          "description": "Comma separated active guild names."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp."
        }
      },
      "required": ["activeGuilds"]
    },
    "customRespawn": {
      "title": "CustomRespawn",
      "description": "Custom hunt respawn added by administrator.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "type": {
          "type": "string",
          "enum": ["normal", "3h"]
        },
        "addedBy": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["name", "type", "addedBy", "createdAt"]
    },
    "doubleXpRecord": {
      "title": "DoubleXpRecord",
      "description": "Player XP snapshot during Double XP weekend.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "charName": {
          "type": "string",
          "maxLength": 60
        },
        "fridayExp": { "type": "number" },
        "saturdayExp": { "type": "number" },
        "sundayExp": { "type": "number" },
        "totalExp": { "type": "number" },
        "startExp": { "type": "number" },
        "lastCapturedAt": { "type": "string" }
      },
      "required": ["uid", "charName", "totalExp"]
    },
    "releasedRespawn": {
      "title": "ReleasedRespawn",
      "description": "Log of respawns voluntarily freed up by players so others can claim them early.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique released respawn identifier."
        },
        "respawnName": {
          "type": "string",
          "maxLength": 80,
          "description": "Name of the freed hunt respawn."
        },
        "timeSlot": {
          "type": "string",
          "maxLength": 40,
          "description": "Time window of the respawn."
        },
        "day": {
          "type": "string",
          "enum": ["friday", "saturday", "sunday"],
          "description": "Weekend day."
        },
        "slotType": {
          "type": "string",
          "enum": ["normal", "3h", "planilhados"],
          "description": "Slot type."
        },
        "charName": {
          "type": "string",
          "maxLength": 60,
          "description": "Character name of the member who released the respawn."
        },
        "userUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID of the player who released the respawn."
        },
        "claimReservationId": {
          "type": "string",
          "maxLength": 128,
          "description": "Target reservation ID created when claiming this released respawn."
        },
        "releasedAt": {
          "type": "string",
          "description": "ISO timestamp when the respawn was freed."
        }
      },
      "required": ["id", "respawnName", "timeSlot", "day", "slotType", "charName", "userUid", "releasedAt"]
    },
    "lfgPost": {
      "title": "LfgPost",
      "description": "Quero Hunt card posted by whitelisted players looking for a party.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique identifier (player userUid)."
        },
        "userUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID of the player."
        },
        "charName": {
          "type": "string",
          "maxLength": 60,
          "description": "Character name."
        },
        "level": {
          "type": "number",
          "description": "Character level."
        },
        "vocation": {
          "type": "string",
          "maxLength": 40,
          "description": "Character vocation."
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "WhatsApp contact number."
        },
        "days": {
          "type": "array",
          "description": "Weekend days available."
        },
        "timeSlots": {
          "type": "string",
          "maxLength": 120,
          "description": "Description of available hours."
        },
        "notes": {
          "type": "string",
          "maxLength": 160,
          "description": "Short note or goal."
        },
        "rank": {
          "type": "string",
          "maxLength": 30,
          "description": "Guild rank."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp when updated."
        }
      },
      "required": ["id", "userUid", "charName", "level", "vocation", "phone", "days", "createdAt"]
    },
    "adminBackup": {
      "title": "AdminBackup",
      "description": "Timestamped backup snapshot of special respawns configuration and bookings (admin-only).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique backup snapshot ID."
        },
        "name": {
          "type": "string",
          "maxLength": 120,
          "description": "Human-readable backup label."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when backup was created."
        },
        "createdBy": {
          "type": "string",
          "maxLength": 120,
          "description": "Admin email who created the backup."
        },
        "specialCount": {
          "type": "number",
          "description": "Number of special reservations included in the snapshot."
        },
        "respawnsCount": {
          "type": "number",
          "description": "Number of special respawns covered."
        },
        "reservations": {
          "type": "array",
          "description": "Special reservations snapshot."
        },
        "slotsConfig": {
          "type": "object",
          "description": "Special slots configuration metadata."
        }
      },
      "required": ["id", "name", "createdAt", "createdBy", "specialCount", "respawnsCount", "reservations"]
    }
  },
  "firestore": {
    "/allowed_emails/{emailId}": {
      "schema": { "$ref": "#/entities/allowedEmail" },
      "description": "List of authorized emails for access control."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/userProfile" },
      "description": "Private guild member profiles containing PII (strictly owner or admin)."
    },
    "/member_directory/{userId}": {
      "schema": { "$ref": "#/entities/memberDirectory" },
      "description": "PII-free directory of registered guild characters for whitelisted members."
    },
    "/reservations/{reservationId}": {
      "schema": { "$ref": "#/entities/reservation" },
      "description": "Guild weekend hunt respawn public occupancy slots."
    },
    "/reservation_details/{reservationId}": {
      "schema": { "$ref": "#/entities/reservationDetails" },
      "description": "Private character and party details accessible only by owner, shared members, or admins."
    },
    "/guild_settings/{settingId}": {
      "schema": { "$ref": "#/entities/guildSetting" },
      "description": "Guild app configuration parameters."
    },
    "/custom_respawns/{respawnId}": {
      "schema": { "$ref": "#/entities/customRespawn" },
      "description": "Custom hunt respawns managed by admin."
    },
    "/double_xp_records/{recordId}": {
      "schema": { "$ref": "#/entities/doubleXpRecord" },
      "description": "Double XP progress records per player."
    },
    "/released_respawns/{releasedId}": {
      "schema": { "$ref": "#/entities/releasedRespawn" },
      "description": "Log of voluntarily freed respawns during double exp weekend."
    },
    "/lfg_posts/{postId}": {
      "schema": { "$ref": "#/entities/lfgPost" },
      "description": "Quero Hunt party search cards (whitelisted guild members only)."
    },
    "/admin_backups/{backupId}": {
      "schema": { "$ref": "#/entities/adminBackup" },
      "description": "Admin-only backups of special respawns configuration."
    }
  }
}
