rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        (request.auth.token.email == 'ederinevitavel@gmail.com' || request.auth.token.email == 'admissclick@gmail.com') &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true) ||
        (isSignedIn() && request.auth.token.email != null && exists(/databases/$(database)/documents/allowed_emails/$(request.auth.token.email.lower())) && get(/databases/$(database)/documents/allowed_emails/$(request.auth.token.email.lower())).data.role == 'admin');
    }

    function isLeader() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rank == 'Leader';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(adminId);
    }

    // Whitelisted emails - ZERO PII EXPOSURE
    // Only administrators can list the authorized email directory.
    // Regular members can ONLY inspect their own exact email document to verify status.
    match /allowed_emails/{emailId} {
      allow get: if isAdmin() || (
        isSignedIn() &&
        request.auth.token.email != null &&
        resource.data.email != null &&
        request.auth.token.email.lower() == resource.data.email.lower()
      );
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(emailId);
    }

    // User profiles - Allow signed-in users to read/list profiles for party selection
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        (request.auth.uid == userId || isAdmin()) &&
        (request.resource.data.isAdmin == false || isBootstrappedAdmin() || isAdmin());
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        (isAdmin() || (request.auth.uid == userId && (request.resource.data.isAdmin == resource.data.isAdmin)));
      allow delete: if isAdmin();
    }

    // Respawns & Schedule Public Slots - Zero PII / Anonymized Occupancy
    // Public schedule for signed in guild members containing only slot occupation status.
    // Restriction: Only Admin or players with Leader rank can create or choose respawns.
    match /reservations/{reservationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidId(reservationId) &&
        (isAdmin() || (isLeader() && request.resource.data.userUid == request.auth.uid));
      allow update: if isSignedIn() &&
        isValidId(reservationId) &&
        (isAdmin() || (isLeader() && resource.data.userUid == request.auth.uid && request.resource.data.userUid == request.auth.uid));
      allow delete: if isSignedIn() && (
        isAdmin() || 
        resource == null || 
        resource.data.userUid == request.auth.uid ||
        (exists(/databases/$(database)/documents/reservation_details/$(reservationId)) && 
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/reservation_details/$(reservationId)).data.charName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.charName)
      );
    }

    // Sensitive Reservation Details (Character Name, Party Members, Notes)
    // STRICT ZERO-KNOWLEDGE BOUNDARY:
    // Members can read own reservation details or records shared via sharedWith array in user profile.
    match /reservation_details/{reservationId} {
      allow get, list: if isSignedIn() && (
        isAdmin() || 
        resource.data.userUid == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(resource.data.userUid)) && 
         request.auth.uid in get(/databases/$(database)/documents/users/$(resource.data.userUid)).data.get('sharedWith', []))
      );
      allow create: if isSignedIn() &&
        isValidId(reservationId) &&
        (isAdmin() || (isLeader() && request.resource.data.userUid == request.auth.uid));
      allow update: if isSignedIn() &&
        isValidId(reservationId) &&
        (isAdmin() || (isLeader() && resource.data.userUid == request.auth.uid && request.resource.data.userUid == request.auth.uid));
      allow delete: if isSignedIn() && (
        isAdmin() || 
        resource == null || 
        resource.data.userUid == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         resource.data.charName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.charName)
      );
    }

    // Global Settings (e.g. double_xp, system_status)
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(settingId);
    }

    // Double XP Records
    match /double_xp_records/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isAdmin() || request.auth.uid == recordId);
    }

    // Global Guild Settings & Public non-PII Statistics
    match /guild_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(settingId);
    }

    // Custom Respawns (Manual Hunts added by Admin)
    match /custom_respawns/{respawnId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(respawnId);
    }

    // Released Respawns - Respawns voluntarily freed up by players so others can claim them early
    match /released_respawns/{releasedId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(releasedId);
      allow update: if isAdmin();
      allow delete: if isSignedIn();
    }

    // Quero Hunt! (LFG Posts - Players looking for party for double exp)
    match /lfg_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidId(postId) &&
        (request.resource.data.userUid == request.auth.uid || isAdmin());
      allow update: if isSignedIn() &&
        isValidId(postId) &&
        (resource.data.userUid == request.auth.uid && request.resource.data.userUid == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() &&
        (resource.data.userUid == request.auth.uid || isAdmin());
    }
  }
}
